{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "Frontend",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vidya-setu.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
